<Window x:Class="Robot_interface.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Robot_interface"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <GroupBox Header="Emission" BorderBrush="Black" Background="#FFDDDDDD" Margin="10,10,10,10" Grid.Column="0" Grid.RowSpan="1">
            <TextBox x:Name="TextBoxEmission" TextWrapping="Wrap" Height="NaN" Background="{x:Null}" TextChanged="TextBox_TextChanged" BorderBrush="{x:Null}" AcceptsReturn="True"/>
        </GroupBox>
        <GroupBox Header="Réception" BorderBrush="Black" Background="#FFDDDDDD" Margin="10,10,10,10" Grid.Column="1" Grid.RowSpan="1">
            <TextBox x:Name="TextBoxReception" TextWrapping="Wrap" Background="{x:Null}" TextChanged="TextBox_TextChanged_1" AcceptsReturn="True" IsReadOnly="True"/>
        </GroupBox>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="bouttonEnvoyer"  Content="Envoyer" Width="100" Margin="5,5,5,5" Click="bouttonEnvoyer_Click"/>
            <Button x:Name="bouttonTest"  Content="Teste" Width="100" Margin="5,5,5,5" Click="bouttonEnvoyer_Click"/>
            <Button x:Name="bouttonNULL"  Content="NULL" Width="100" Margin="5,5,5,5" Click="bouttonEnvoyer_Click"/>
        </StackPanel>
    </Grid>
</Window>
